# V821 rv32 minimal initramfs (source list for gen_init_cpio).
# The Makefile substitutes @TOP@ with the repo root to produce build/initramfs.list,
# then points CONFIG_INITRAMFS_SOURCE at it with scripts/config.
#
# These paths must be absolute: kbuild runs gen_init_cpio with the O= objtree as CWD,
# so a relative path would resolve inside the build directory, not the repo.
#
# busybox is an rv32imac / ilp32 soft-float static binary, matching the
# riscv,isa-extensions declared in the dts. A hard-float build SIGILLs on the fsd in
# __sigsetjmp.
dir  /dev 0755 0 0
nod  /dev/console 0600 0 0 c 5 1
dir  /proc 0755 0 0
dir  /sys 0755 0 0
dir  /bin 0755 0 0
file /bin/busybox @TOP@/initramfs/prebuilt/busybox 0755 0 0
file /init      @TOP@/initramfs/init.sh          0755 0 0
