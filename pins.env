# Upstream sources and pinned commits. The Makefile reads this with include and
# fetch.sh with ., so it may only contain KEY=value with no spaces around the =.
#
# LINUX_SHA must be a commit hash, not a tag: this one is v7.0-rc4-315-g..., which
# differs from the v7.0-rc4 tag by 264 files and +2404/-1287 lines. Pinning the tag
# would build a kernel that has never been on the board.

LINUX_URL=https://github.com/torvalds/linux.git
LINUX_SHA=a0c83177734ab98623795e1ba2cf4b72c23de5e7

# OpenSBI upstream master, 2026-05-13. The banner prints v1.8.
OPENSBI_URL=https://github.com/riscv-software-src/opensbi.git
OPENSBI_SHA=547a5bbda7c3ec0096a6c87809851f8c2df047d1
