/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Allwinner V821 AvaotaF1 (minimal bring-up)";
	compatible = "allwinner,v821", "allwinner,sun300iw1p1";

	chosen {
		stdout-path = "serial0:115200n8";
		/* Console 直驅 UART0 硬體（ttyS0），跟原廠一樣。
		 * earlycon 用 uart8250,mmio32 且不帶 baud，所以它沿用 bootloader
		 * 已經設好的 divisor -> 不管 clock-frequency 寫多少都不會亂碼。
		 * 不用 hvc0/SBI console：兩個 master 搶同一顆 UART 會把 console 寫壞
		 * （這才是早期 [0.387] 亂碼的真因，不是 UART0 不能用）。 */
		bootargs = "earlycon=uart8250,mmio32,0x42500000 console=ttyS0,115200 loglevel=8";
	};

	aliases {
		serial0 = &uart0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <40000000>;	/* 40 MHz, from passed.dts */

		cpu0: cpu@0 {
			device_type = "cpu";
			reg = <0>;
			compatible = "andestech,a27", "riscv";
			/* ISA 只用新介面（riscv,isa-base + riscv,isa-extensions），
			 * 刻意不放 deprecated 的 riscv,isa。
			 *
			 * 為什麼可以不放：kernel 的 riscv_early_of_processor_hartid()
			 * 先讀 isa-base，只有在它不存在時才 goto old_interface
			 * （c98f136aedbd）。所以新介面自己就夠。
			 *
			 * 代價（重要）：OpenSBI v1.4 的 fdt_parse_isa_all_harts() 只認得
			 * legacy 屬性（fdt_helper.c:437），拿這份 dts 配 v1.4 會 SBI_ENOENT
			 * -> generic_extensions_init() 失敗 -> 在 console 起來之前就靜默卡死在
			 * sbi_hart_hang()。要退回 v1.4 就得把 riscv,isa = "rv32imac"; 加回來。
			 * 上游 master（本 repo 的預設）認得新介面，沒這個問題。
			 *
			 * 為什麼沒有 f/d：A27 有 FPU，但 userspace 是 soft-float（ilp32），
			 * 而且 FP save/restore 路徑在這顆上行為不正常（claude-report.md 困難點 5）。
			 * 宣告成 rv32imac 讓 kernel 的 has_fpu()=false、__switch_to_fpu 變成
			 * no-op，context-switch 路徑上一條 FP 指令都不會出現。
			 * 注意 prebuilt/busybox 也是照這個 ABI 編的——兩者必須一致，
			 * 用 hard-float 的 binary 會在 __sigsetjmp 的 fsd 上 SIGILL。
			 *
			 * zicsr/zifencei/zicntr/zihpm 要明寫：「i 隱含它們」這個 quirk
			 * （cpufeature.c:884）只存在於 legacy 路徑，新介面必須逐一列出
			 * 才等價於 rv32imac。 */
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "c",
					       "zicsr", "zifencei", "zicntr", "zihpm";
			mmu-type = "riscv,sv32";
			status = "okay";

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x04000000>;	/* 64 MB */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* 保留給 vendor OpenSBI 的常駐區（原廠 boot.log: opensbi_base=0x80fc0000），
		 * 256 KB 足夠涵蓋 fw + heap + per-hart scratch。
		 *
		 * 注意：走本 repo 的 FEL 路徑時，我們自己的 OpenSBI 是在 0x80000000，
		 * 這塊其實用不到。保留它是因為 (a) 同一份 dts 也能餵給 vendor 開機鏈，
		 * (b) 已驗證開機的記憶體佈局就是長這樣，拿掉等於改動一個實測過的組態
		 * 卻換不到任何好處。 */
		opensbi@80fc0000 {
			reg = <0x80fc0000 0x00040000>;
			no-map;
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		/* UART0: the kernel drives this hardware DIRECTLY (console=ttyS0),
		 * exactly like the factory Tina kernel (boot.log: "ttyS0 at MMIO
		 * 0x42500000"). Vendor OpenSBI's console is PASSIVE -- it only
		 * touches UART0 when the kernel makes an SBI console ecall -- so as
		 * long as our console is ttyS0 (not hvc0) and we never use the SBI
		 * console, OpenSBI does not contend for this UART. (The earlier
		 * "[0.387] garbage + reset" was self-inflicted: it ran earlycon=sbi/
		 * hvc0 AND the 8250 driver on UART0 at the same time.)
		 *   clock-frequency = 192 MHz: the UART ref clock is pll-peri-cko-192m
		 *     (PERI PLL 3072 MHz / 16); boot.log prints "uartclk 192000000"
		 *     and "base_baud = 12000000". 115200 divisor = 192e6/(16*115200)
		 *     = 104. (The old 24 MHz here was wrong -> 8x-too-fast garbage.)
		 * IRQ MODE (re-armed 2026-08-11, see claude-report.md §29): hwirq 3 comes
		 * from the vendor dtsi (sun300iw1p1.dtsi:496); PLIC #interrupt-cells = 2
		 * so the cells are <hwirq, IRQ_TYPE_LEVEL_HIGH>. This line WAS commented
		 * out because the board RESET on the first interactive RX -- but that was
		 * observed under the VENDOR OpenSBI, the same firmware that also produced
		 * the silent 62s deadman, the fid-33 ebreak halt and the uncatchable-CSR
		 * resets. Since §21 we run our own OpenSBI master with the A27 fixes
		 * (CLEAR_MDT/mstatush, CSR guards, delegation) and the IRQ path has never
		 * been retried on it. §15.28 had narrowed the fault to "idle-exit -> trap
		 * entry, BEFORE serial8250_read_char", which is exactly the M-mode code
		 * that got replaced -- so the old conclusion has no basis on this stack.
		 * CONFIRM WITH BOTH: (a) boot line "ttyS0 at MMIO ... (irq = <N>" with N
		 * non-zero -- proves the DT property parsed and the PLIC domain mapped it,
		 * but that is software bookkeeping only and a WRONG hwirq also passes;
		 * (b) /proc/interrupts row for the UART whose count RISES as you type --
		 * that needs the real wire, so it is the decisive one.
		 * POLLED FALLBACK: if the reset returns, comment this line out again --
		 * the 8250 core then polls RX on a timer (irq=0), TX fine, RX with a few
		 * ms latency, and there is no IRQ path at all. */
		uart0: serial@42500000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x42500000 0x400>;
			reg-shift = <2>;
			reg-io-width = <4>;
			interrupts-extended = <&plic 3 4>;  // hwirq 3: caused reset-on-RX
			clock-frequency = <192000000>;	/* pll-peri-cko-192m; div=104 @115200 */
			current-speed = <115200>;
			status = "okay";
		};

		plic: interrupt-controller@48000000 {
			compatible = "riscv,plic0";	/* vendor passed.dts value */
			#address-cells = <0>;
			#interrupt-cells = <2>;
			interrupt-controller;
			reg = <0x48000000 0x00400000>;
			riscv,ndev = <187>;		/* 0xbb, from passed.dts */
			interrupts-extended = <&cpu0_intc 11>, <&cpu0_intc 9>;
		};

		/* Andes PLMT (Platform-Level Machine Timer): the RISC-V machine timer,
		 * mtime @ 0x48400000 (SUNXI_PLMT_BASE, from the SDK cpu_autogen.h).
		 * OpenSBI's andes_plmt / fdt_timer_plmt driver matches "andestech,plmt0"
		 * and uses it to back SBI set_timer. WITHOUT this the kernel finds no
		 * clocksource, falls back to "jiffies", gets no timer tick and hangs at
		 * cpuidle; WITH it the kernel gets riscv_clocksource and boots through. */
		plmt: timer@48400000 {
			compatible = "andestech,plmt0";
			reg = <0x48400000 0x100000>;
			interrupts-extended = <&cpu0_intc 7>;	/* hart0 M-timer (mtip) */
		};
	};
};
