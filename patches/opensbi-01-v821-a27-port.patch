diff --git a/lib/utils/serial/uart8250.c b/lib/utils/serial/uart8250.c
index d65f127..869e9d7 100644
--- a/lib/utils/serial/uart8250.c
+++ b/lib/utils/serial/uart8250.c
@@ -98,6 +98,30 @@ static int uart8250_getc(void)
 	return uart8250_device_getc(&uart8250_dev);
 }
 
+/*
+ * V821: UART0 is a Synopsys dw-apb-uart. An LCR write while the UART is "busy"
+ * (mid-transfer) is silently DROPPED and latches a busy-detect; the dw-apb USR
+ * (status register) must be read to clear it. The generic 8250 init doesn't do
+ * this, so on a dw-apb the LCR writes in uart8250_init wedge the port. Write LCR
+ * busy-safe: if the value didn't latch, clear busy via USR and retry.
+ *
+ * Linux does the same thing in dw8250_check_lcr()
+ * (drivers/tty/serial/8250/8250_dw.c).
+ */
+#define UART_USR_OFFSET		0x1f	/* dw-apb UART Status Register */
+static void uart8250_set_lcr(struct uart8250_device *dev, u32 val)
+{
+	int i;
+
+	for (i = 0; i < 10000; i++) {
+		set_reg(dev, UART_LCR_OFFSET, val);
+		if (get_reg(dev, UART_LCR_OFFSET) == val)
+			return;
+		(void)get_reg(dev, UART_USR_OFFSET);	/* clear busy-detect */
+		(void)get_reg(dev, UART_RBR_OFFSET);	/* drain pending rx */
+	}
+}
+
 static struct sbi_console_device uart8250_console = {
 	.name = "uart8250",
 	.console_putc = uart8250_putc,
@@ -124,8 +148,8 @@ void uart8250_device_init(struct uart8250_device *dev, unsigned long base,
 	/* Disable all interrupts */
