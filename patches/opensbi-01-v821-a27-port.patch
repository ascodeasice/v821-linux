 	}
 
-	/* 8 bits, no parity, one stop bit */
-	set_reg(dev, UART_LCR_OFFSET, 0x03);
+	/* 8 bits, no parity, one stop bit (busy-safe for dw-apb) */
+	uart8250_set_lcr(dev, 0x03);
 	/* Enable FIFO */
