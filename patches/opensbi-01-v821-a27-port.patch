+/* V821: a SIMPLE direct-UART0 console for OpenSBI. The stock dw-apb fdt-serial
+ * probe hangs on this SoC, but this direct putc/getc works. Registering it gives
+ * OpenSBI its banner AND backs the SBI console extension. */
+static void v821_putc(char ch)
+{
+	volatile unsigned int *u = (volatile unsigned int *)0x42500000UL;
+	while (!(u[5] & 0x20))
+		;
+	u[0] = (unsigned char)ch;
+}
+
+static int v821_getc(void)
+{
+	volatile unsigned int *u = (volatile unsigned int *)0x42500000UL;
+
+	if (u[5] & 0x01)
+		return (int)(u[0] & 0xff);
+	return -1;
+}
+
+static const struct sbi_console_device v821_console = {
+	.name = "v821-uart0",
+	.console_putc = v821_putc,
+	.console_getc = v821_getc,
+};
